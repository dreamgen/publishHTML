{
  "id": "pocketReader",
  "name": "隨身閱讀 PocketReader",
  "short_name": "隨身閱讀",
  "description": "離線隨身書庫與背誦查閱工具：支援 PDF 自動抽字與離線 OCR、EPUB、Word、純文字大字重排、雙指縮放、背誦遮罩、語音朗讀與跨裝置雲端同步。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FAF9F6",
  "theme_color": "#5F6F58",
  "lang": "zh-TW",
  "categories": ["books", "education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "application/epub+zip",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/plain",
            "text/markdown",
            "application/octet-stream",
            ".pdf",
            ".txt",
            ".md",
            ".epub",
            ".docx"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icons/pocketReader-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/pocketReader-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/pocketReader-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/pocketReader-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pocketReader-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pocketReader-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
