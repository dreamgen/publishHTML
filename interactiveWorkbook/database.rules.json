{
  "rules": {
    "artifacts": {
      "interactiveWorkbook": {
        "public": {
          "data": {
            "courses": {
              "$code": {
                ".read": "auth != null",
                ".write": "auth != null"
              }
            },
            "live": {
              "$code": {
                ".read": "auth != null",
                ".write": "auth != null"
              }
            },
            "images": {
              "$code": {
                ".read": "auth != null",
                ".write": "auth != null",
                "$gid": {
                  "$qid": {
                    "$img": {
                      ".validate": "newData.child('data').isString() && newData.child('data').val().beginsWith('data:image/') && newData.child('data').val().length < 700000"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "liveInteraction": {
        "public": {
          "data": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
