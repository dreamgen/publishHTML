{
  "id": "pdfEditor",
  "name": "PDF 工坊 - 本機 PDF 編輯器",
  "short_name": "PDF 工坊",
  "description": "完全在裝置本機處理的 PDF 編輯器，支援密碼文件、頁面整理、手寫標註、簽名與表單。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#f8fafc",
  "lang": "zh-TW",
  "categories": ["productivity", "utilities"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "pdf",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icons/pdfEditor-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pdfEditor-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pdfEditor-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "開啟 PDF",
      "short_name": "開啟",
      "description": "開啟 PDF 工坊並選擇文件",
      "url": "./?action=open",
      "icons": [
        {
          "src": "./icons/pdfEditor-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
