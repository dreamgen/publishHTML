{
  "id": "pdfEditor",
  "name": "PDF 工坊 - 本機 PDF 編輯器",
  "short_name": "PDF 工坊",
  "description": "完全在裝置本機處理的 PDF 頁面整理、合併、拆分與文字標註工具。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#f8fafc",
  "lang": "zh-TW",
  "categories": ["productivity", "utilities"],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icons/pdfEditor-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pdfEditor-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/pdfEditor-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "開啟 PDF",
      "short_name": "開啟",
      "description": "開啟 PDF 工坊並選擇文件",
      "url": "./?action=open",
      "icons": [
        {
          "src": "./icons/pdfEditor-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
